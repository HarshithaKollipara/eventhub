rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOrganizer() {
      return isAuthenticated() && exists(/databases/$(database)/documents/organizers/$(request.auth.uid));
    }

    function isStudent() {
      return isAuthenticated() && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    // Organizers collection: Read allowed for authenticated users to load profile/verify; write only by the organizer themselves
    match /organizers/{organizerId} {
  allow read: if request.auth != null;
  allow write: if false;
}

    // Students collection: Read allowed for authenticated users; students can only manage their own profile
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == studentId;
      allow delete: if false;
    }

    // Events collection
    match /events/{eventId} {
      // Authenticated students and organizers can read events
      allow read: if isAuthenticated();

      // Only authenticated organizers with a matching organizers/{uid} profile can create events
      allow create: if isOrganizer() 
        && request.resource.data.organizerId == request.auth.uid;

      // An organizer can update or delete only their own events
      allow update, delete: if isOrganizer() 
        && resource.data.organizerId == request.auth.uid;
    }

    // Registrations collection
    match /registrations/{registrationId} {
      // Authenticated students and organizers can read registrations
      allow read: if isAuthenticated();

      // Only authenticated students can register for events using their own studentId
      allow create: if isStudent() 
        && request.resource.data.studentId == request.auth.uid;

      // Updating or deleting registrations
      allow update, delete: if isOrganizer() || (isStudent() && resource.data.studentId == request.auth.uid);
    }
  }
}
